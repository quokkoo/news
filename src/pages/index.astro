---
import Base from "../layouts/Base.astro";
import NewsCard from "../components/NewsCard.astro";
import { formatDateCN, loadLatest, tenMinuteKeepIds, totalMinutes } from "../lib/data.ts";

const day = loadLatest();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const allItems = day?.sections.flatMap((s) => s.items) ?? [];
const itemById = new Map(allItems.map((i) => [i.id, i]));
const keepIds = day ? tenMinuteKeepIds(day) : new Set<string>();
const minutes = totalMinutes(allItems);

const tenMinuteCount = allItems.filter((i) => keepIds.has(i.id)).length;

const title = day ? `${day.date} 每日精读 · 30 分钟读完今天` : "每日精读";
const description = day
  ? day.brief.overview.slice(0, 110)
  : "每天早上 7 点前，从几百条资讯里挑出真正值得读的。";
---

<Base title={title} description={description} showTenMinute={!!day}>
  {
    !day ? (
      <div class="wrap">
        <p class="empty">还没有生成任何简报。本地运行 <code>npm run pipeline</code> 或在 GitHub Actions 里手动触发 <code>daily.yml</code>。</p>
      </div>
    ) : (
      <>
        <div class="wrap">
          <div class="dayhead">
            <h1>{formatDateCN(day.date)}</h1>
            <p class="meta">
              收录 {day.stats.itemsPublished} 条 · 全部读完约 {minutes} 分钟 ·
              10 分钟模式下 {tenMinuteCount} 条 · 数据源 {day.stats.sourcesOk} 个正常
              {day.stats.sourcesFailed > 0 && <> / {day.stats.sourcesFailed} 个异常</>}
            </p>
          </div>

          {day.degradedMode && (
            <p class="degraded-banner">
              <strong>今日为降级模式。</strong>
              {day.degradedReason ?? "AI 评估环节不可用"}
              ——下面的排序基于来源权重与报道家数，没有经过 AI 评估，摘要与「为什么重要」也不会出现。请自行判断。
            </p>
          )}

          {/* ── 今日导读：视觉权重最高 ── */}
          <section class="brief" aria-labelledby="brief-h">
            <h2 id="brief-h" class="brief-label">今 日 导 读</h2>
            <p class="brief-overview">{day.brief.overview}</p>

            {day.brief.topPicks.length > 0 && (
              <>
                <h3 class="visually-hidden">今天只读这三条</h3>
                <ol class="picks">
                  {day.brief.topPicks.map((p) => {
                    const it = itemById.get(p.itemId);
                    if (!it) return null;
                    return (
                      <li>
                        <div>
                          <a class="pick-title" href={it.url} target="_blank" rel="noopener noreferrer">
                            {it.titleZh}
                          </a>
                          {p.reason && <p class="pick-reason">{p.reason}</p>}
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </>
            )}

            {day.brief.skip && (
              <p class="brief-skip"><b>可以跳过</b>{day.brief.skip}</p>
            )}
          </section>

          {/* ── 领域筛选 ── */}
          <nav class="filterbar" aria-label="按领域筛选">
            <div class="chips" role="group">
              <button type="button" id="chip-all" class="chip" aria-pressed="true">全部</button>
              {day.sections.map((s) => (
                <button type="button" class="chip" data-topic={s.topicId} aria-pressed="false">
                  {s.name}
                </button>
              ))}
            </div>
          </nav>

          {/* ── 各领域分区 ── */}
          {day.sections.map((s) => {
            const hiddenInTen = s.items.filter((i) => !keepIds.has(i.id)).length;
            return (
              <section
                class="section"
                id={s.topicId}
                data-topic={s.topicId}
                data-core={s.core ? "true" : "false"}
                aria-labelledby={`h-${s.topicId}`}
              >
                <div class="section-head">
                  <h2 id={`h-${s.topicId}`}>{s.name}</h2>
                  <span class="badge-time">
                    {s.targetMinutes ? `${s.targetMinutes[0]}–${s.targetMinutes[1]} 分钟` : "不限时"}
                  </span>
                </div>
                <p class="section-desc">{s.description}</p>

                <ul class="section-list">
                  {s.items.map((item) => (
                    <li data-ten={keepIds.has(item.id) ? "1" : "0"}>
                      <NewsCard item={item} refDate={day.date} />
                    </li>
                  ))}
                </ul>

                {hiddenInTen > 0 && (
                  <p class="ten-note">10 分钟模式下已折叠该栏目其余 {hiddenInTen} 条。</p>
                )}
              </section>
            );
          })}

          <p style="color:var(--text-muted);font-size:13.5px">
            想回看往期？<a href={`${base}/archive`} style="text-decoration:underline;text-underline-offset:2px">查看历史归档 →</a>
          </p>
        </div>
      </>
    )
  }
</Base>
